# Single source of truth for local configuration.
#
#   cp .env.example .env
#
# Then edit the values below. `.env` is gitignored — never commit real
# secrets. Docker Compose, the backend (via python-dotenv) and the frontend
# (via Vite's envDir, see frontend/vite.config.ts) all read from this one
# file, so there's exactly one place to look for "what talks to what".

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=loadboard
POSTGRES_PASSWORD=loadboard
POSTGRES_DB=loadboard
# Host port Postgres is published on (kept off 5432 to avoid clashing with a
# Postgres already running on your machine).
POSTGRES_PORT=5433

# Connection string for the backend when it runs OUTSIDE Docker (PyCharm run
# configs, `uvicorn app.main:app` from your shell, pytest, ...).
DATABASE_URL=postgresql://loadboard:loadboard@localhost:5433/loadboard

# Connection string used INSIDE docker-compose, where the DB is reachable by
# its service name (`db`) on the internal network rather than `localhost`.
DATABASE_URL_DOCKER=postgresql://loadboard:loadboard@db:5432/loadboard

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a real one with: openssl rand -hex 32
# Never reuse the same secret across environments (dev/staging/prod).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# ── Backend ───────────────────────────────────────────────────────────────
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5173

# ── AI (NL search) ──────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys — never commit
# the real value. Without it, POST /api/search falls back to an unfiltered
# list instead of erroring (see docs/technical-documentation.html section 7).
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# ── Frontend (Vite) ─────────────────────────────────────────────────────
# Must be prefixed VITE_ to be exposed to client-side code.
VITE_API_URL=http://localhost:8001
